rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == 'superadmin';
    }

    function isClubAdmin(clubId) {
      return request.auth != null
          && request.auth.token.role == 'clubadmin'
          && request.auth.token.clubId == clubId;
    }

    // A scoreboard paired with a sheet in this club. pairSheet sets the
    // claims, which only say which sheet to look at: the sheet itself has to
    // name this scoreboard, so access ends the moment it is disconnected or
    // another device is paired in its place.
    function isClubScoreboard(clubId) {
      return request.auth != null
          && request.auth.token.role == 'scoreboard'
          && request.auth.token.clubId == clubId
          && get(/databases/$(database)/documents/clubs/$(clubId)/sheets/$(request.auth.token.sheetId))
              .data.get('scoreboardUid', null) == request.auth.uid;
    }

    // A club's score bug or warm room screen, signed in through one of the
    // club's display links by the startDisplaySession function. It can read
    // the club's display summary and nothing else.
    function isClubDisplay(clubId) {
      return request.auth != null
          && request.auth.token.role == 'display'
          && request.auth.token.clubId == clubId;
    }

    // What a display link shows: the warm room, or a sheet's score bug, with
    // the options each page takes. Kept to what the pages understand.
    function isDisplaySettings(settings) {
      return settings is map
          && settings.keys().hasOnly(['page', 'sheetId', 'view', 'every', 'scale', 'label'])
          && settings.get('page', '') in ['bug', 'warm-room']
          && (settings.page != 'bug'
              || (settings.get('sheetId', null) is string
                  && settings.sheetId.matches('^[A-Za-z0-9_-]{1,128}$')))
          && settings.get('view', 'totals') in ['totals', 'full', 'cycle']
          && (!('every' in settings)
              || (settings.every is int && settings.every >= 5 && settings.every <= 300))
          && (!('scale' in settings)
              || (settings.scale is number && settings.scale >= 0.5 && settings.scale <= 4))
          && settings.get('label', 'sheet') in ['sheet', 'league', 'none'];
    }

    function isRockColor(color) {
      return color.keys().hasOnly(['name', 'hex'])
          && color.name is string
          && color.name.size() > 0
          && color.name.size() <= 20
          && color.hex is string
          && color.hex.matches('^#[0-9a-fA-F]{6}$');
    }

    // Only the outline of a league is checked. Club admins are trusted with
    // their own club's teams; this just keeps the document a sensible size
    // and shape for the scoreboards that read it.
    function isLeague(league) {
      return league.keys().hasAll(['name', 'active', 'draws', 'teams'])
          && league.keys().hasOnly(['name', 'active', 'seasonStart', 'seasonEnd', 'draws', 'teams'])
          && league.name is string
          && league.name.size() > 0
          && league.name.size() <= 80
          && league.active is bool
          && league.draws is list
          && league.draws.size() <= 30
          && league.teams is list
          && league.teams.size() <= 300;
    }

    // Super admins can read and write everything.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Deployment info the scoreboards watch so they can reload onto a new
    // build. Scoreboards may not be signed in until paired, and nothing here
    // is sensitive, so anyone can read it. Only deploys write it.
    match /appConfig/{docId} {
      allow read: if true;
    }

    // Pairing goes through the pairSheet Cloud Function, which looks the code
    // up with admin access. Clients get no access to pairing codes or to the
    // clubs they do not administer.
    match /clubs/{clubId} {
      allow read: if isClubAdmin(clubId);

      // The club's API key. Club admins can see it; only super admins (via
      // the rule at the top) can change it.
      match /private/{docId} {
        allow read: if isClubAdmin(clubId);
      }

      // The PIN that has to be entered on a scoreboard to disconnect it.
      // Club admins choose it. Scoreboards never read it: the unpairSheet
      // function checks what was typed.
      match /private/scoreboardPin {
        allow create, update: if isClubAdmin(clubId)
            && request.resource.data.keys().hasOnly(['pin'])
            && request.resource.data.pin is string
            && request.resource.data.pin.matches('^[0-9]{4,8}$');
      }

      // Where the club's completed games are posted. Club admins set it
      // themselves, since the Slack or Discord channel it points at is
      // theirs. It is kept here, out of reach of scoreboards, because
      // whoever holds the URL can post to that channel. The message
      // template and the time zone its dates are written in are optional:
      // without them the default message is posted, with times in UTC.
      match /private/webhook {
        allow create, update: if isClubAdmin(clubId)
            && request.resource.data.keys().hasAll(['url', 'games'])
            && request.resource.data.keys().hasOnly(['url', 'games', 'template', 'timeZone'])
            && request.resource.data.url is string
            && request.resource.data.url.size() <= 500
            && request.resource.data.url.matches('^https://.+')
            && request.resource.data.games in ['all', 'league']
            && (!('template' in request.resource.data)
                || (request.resource.data.template is string
                    && request.resource.data.template.size() <= 1000))
            && (!('timeZone' in request.resource.data)
                || (request.resource.data.timeZone is string
                    && request.resource.data.timeZone.size() <= 64));
        allow delete: if isClubAdmin(clubId);
      }

      // What the club's display pages show, kept by the functions from the
      // sheets and their completed games. Club admins can read it through
      // the rule on private above.
      match /private/displayState {
        allow read: if isClubDisplay(clubId);
      }

      // The warm room screen's title and logo, set by club admins and read by
      // the club's displays. The logo is a small image resized in the
      // portal, kept as a data URL so the displays need nothing but
      // Firestore. Only raster images: no SVG, which can carry scripts.
      match /private/displayBranding {
        allow read: if isClubDisplay(clubId);
        allow create, update: if isClubAdmin(clubId)
            && request.resource.data.keys().hasOnly(['title', 'logo'])
            && (!('title' in request.resource.data)
                || (request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 60))
            && (!('logo' in request.resource.data)
                || (request.resource.data.logo is string
                    && request.resource.data.logo.size() <= 250000
                    && request.resource.data.logo.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+=*$')));
        allow delete: if isClubAdmin(clubId);
      }

      // The links the club's displays sign in with. Club admins see them in
      // the portal; the functions create, reset and remove them, since only a
      // hash of each token is kept and the token is shown once. Admins change
      // a link's name and what it shows, and a display reads its own link to
      // follow those settings. The hash is no use to the screen holding the
      // token it was made from.
      match /displayLinks/{linkId} {
        allow read: if isClubAdmin(clubId)
            || (isClubDisplay(clubId) && request.auth.token.linkId == linkId);
        allow update: if isClubAdmin(clubId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'settings'])
            && request.resource.data.label is string
            && request.resource.data.label.size() > 0
            && request.resource.data.label.size() <= 60
            && isDisplaySettings(request.resource.data.settings);
      }

      match /admins/{uid} {
        allow read: if isClubAdmin(clubId);
      }

      // Club settings the scoreboards need, which is why they are kept off
      // the club document: paired scoreboards can read these and nothing
      // else about the club.
      match /config/{docId} {
        allow read: if isClubAdmin(clubId) || isClubScoreboard(clubId);
      }

      // Club admins choose the rock colors their scoreboards use. Removing
      // the setting puts the scoreboards back on red and yellow.
      match /config/scoreboard {
        allow write: if isClubAdmin(clubId)
            && request.resource.data.keys().hasOnly(['rockColors'])
            && (!('rockColors' in request.resource.data)
                || (request.resource.data.rockColors.keys().hasOnly(['team1', 'team2'])
                    && isRockColor(request.resource.data.rockColors.team1)
                    && isRockColor(request.resource.data.rockColors.team2)));
      }

      // Leagues and their teams. Club admins manage them; the club's paired
      // scoreboards read them to offer teams when a league game is started.
      match /leagues/{leagueId} {
        allow read: if isClubAdmin(clubId) || isClubScoreboard(clubId);
        allow create, update: if isClubAdmin(clubId) && isLeague(request.resource.data);
        allow delete: if isClubAdmin(clubId);
      }

      match /sheets/{sheetId} {
        // Club admins can read any sheet in their club.
        allow read: if isClubAdmin(clubId);

        // Club admins can manage sheets in their club (add pairing codes, add sheets).
        allow write: if isClubAdmin(clubId);

        // Only the registered scoreboard (matched by UID) can read the sheet.
        allow read: if request.auth != null
            && request.auth.uid == resource.data.scoreboardUid;

        // The registered scoreboard can update liveGame and report its own
        // device status. Disconnecting goes through the unpairSheet function,
        // which asks for the club's admin PIN, so the scoreboard cannot let go
        // of the sheet or hand it to another device. The device status is
        // whatever the scoreboard says about itself, so it is only held to
        // being a map of a sensible size.
        allow update: if request.auth != null
            && request.auth.uid == resource.data.scoreboardUid
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['liveGame', 'device'])
            && (!('device' in request.resource.data)
                || (request.resource.data.device is map
                    && request.resource.data.device.size() <= 20));

        match /games/{gameId} {
          // Club admins can read game history.
          allow read: if isClubAdmin(clubId);

          // Only the registered scoreboard can write game records.
          allow create: if request.auth != null
              && request.auth.uid ==
                  get(/databases/$(database)/documents/clubs/$(clubId)/sheets/$(sheetId)).data.scoreboardUid;
        }
      }
    }
  }
}
