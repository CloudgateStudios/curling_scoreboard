rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == 'superadmin';
    }

    function isClubAdmin(clubId) {
      return request.auth != null
          && request.auth.token.role == 'clubadmin'
          && request.auth.token.clubId == clubId;
    }

    // A scoreboard paired with a sheet in this club. pairSheet sets the
    // claims, which only say which sheet to look at: the sheet itself has to
    // name this scoreboard, so access ends the moment it is disconnected or
    // another device is paired in its place.
    function isClubScoreboard(clubId) {
      return request.auth != null
          && request.auth.token.role == 'scoreboard'
          && request.auth.token.clubId == clubId
          && get(/databases/$(database)/documents/clubs/$(clubId)/sheets/$(request.auth.token.sheetId))
              .data.get('scoreboardUid', null) == request.auth.uid;
    }

    function isRockColor(color) {
      return color.keys().hasOnly(['name', 'hex'])
          && color.name is string
          && color.name.size() > 0
          && color.name.size() <= 20
          && color.hex is string
          && color.hex.matches('^#[0-9a-fA-F]{6}$');
    }

    // Only the outline of a league is checked. Club admins are trusted with
    // their own club's teams; this just keeps the document a sensible size
    // and shape for the scoreboards that read it.
    function isLeague(league) {
      return league.keys().hasAll(['name', 'active', 'draws', 'teams'])
          && league.keys().hasOnly(['name', 'active', 'seasonStart', 'seasonEnd', 'draws', 'teams'])
          && league.name is string
          && league.name.size() > 0
          && league.name.size() <= 80
          && league.active is bool
          && league.draws is list
          && league.draws.size() <= 30
          && league.teams is list
          && league.teams.size() <= 300;
    }

    // Super admins can read and write everything.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Deployment info the scoreboards watch so they can reload onto a new
    // build. Scoreboards may not be signed in until paired, and nothing here
    // is sensitive, so anyone can read it. Only deploys write it.
    match /appConfig/{docId} {
      allow read: if true;
    }

    // Pairing goes through the pairSheet Cloud Function, which looks the code
    // up with admin access. Clients get no access to pairing codes or to the
    // clubs they do not administer.
    match /clubs/{clubId} {
      allow read: if isClubAdmin(clubId);

      // The club's API key. Club admins can see it; only super admins (via
      // the rule at the top) can change it.
      match /private/{docId} {
        allow read: if isClubAdmin(clubId);
      }

      match /admins/{uid} {
        allow read: if isClubAdmin(clubId);
      }

      // Club settings the scoreboards need, which is why they are kept off
      // the club document: paired scoreboards can read these and nothing
      // else about the club.
      match /config/{docId} {
        allow read: if isClubAdmin(clubId) || isClubScoreboard(clubId);
      }

      // Club admins choose the rock colors their scoreboards use. Removing
      // the setting puts the scoreboards back on red and yellow.
      match /config/scoreboard {
        allow write: if isClubAdmin(clubId)
            && request.resource.data.keys().hasOnly(['rockColors'])
            && (!('rockColors' in request.resource.data)
                || (request.resource.data.rockColors.keys().hasOnly(['team1', 'team2'])
                    && isRockColor(request.resource.data.rockColors.team1)
                    && isRockColor(request.resource.data.rockColors.team2)));
      }

      // Leagues and their teams. Club admins manage them; the club's paired
      // scoreboards read them to offer teams when a league game is started.
      match /leagues/{leagueId} {
        allow read: if isClubAdmin(clubId) || isClubScoreboard(clubId);
        allow create, update: if isClubAdmin(clubId) && isLeague(request.resource.data);
        allow delete: if isClubAdmin(clubId);
      }

      match /sheets/{sheetId} {
        // Club admins can read any sheet in their club.
        allow read: if isClubAdmin(clubId);

        // Club admins can manage sheets in their club (add pairing codes, add sheets).
        allow write: if isClubAdmin(clubId);

        // Only the registered scoreboard (matched by UID) can read the sheet.
        allow read: if request.auth != null
            && request.auth.uid == resource.data.scoreboardUid;

        // The registered scoreboard can update liveGame, report its own
        // device status, or clear its UID on disconnect. It cannot hand the
        // sheet to a different device. The device status is whatever the
        // scoreboard says about itself, so it is only held to being a map of
        // a sensible size.
        allow update: if request.auth != null
            && request.auth.uid == resource.data.scoreboardUid
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['liveGame', 'scoreboardUid', 'device'])
            && (!('scoreboardUid' in request.resource.data)
                || request.resource.data.scoreboardUid == request.auth.uid)
            && (!('device' in request.resource.data)
                || (request.resource.data.device is map
                    && request.resource.data.device.size() <= 20));

        match /games/{gameId} {
          // Club admins can read game history.
          allow read: if isClubAdmin(clubId);

          // Only the registered scoreboard can write game records.
          allow create: if request.auth != null
              && request.auth.uid ==
                  get(/databases/$(database)/documents/clubs/$(clubId)/sheets/$(sheetId)).data.scoreboardUid;
        }
      }
    }
  }
}
