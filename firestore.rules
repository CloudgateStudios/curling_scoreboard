rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == 'superadmin';
    }

    function isClubAdmin(clubId) {
      return request.auth != null
          && request.auth.token.role == 'clubadmin'
          && request.auth.token.clubId == clubId;
    }

    // Super admins can read and write everything.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Deployment info the scoreboards watch so they can reload onto a new
    // build. Scoreboards may not be signed in until paired, and nothing here
    // is sensitive, so anyone can read it. Only deploys write it.
    match /appConfig/{docId} {
      allow read: if true;
    }

    // Pairing goes through the pairSheet Cloud Function, which looks the code
    // up with admin access. Clients get no access to pairing codes or to the
    // clubs they do not administer.
    match /clubs/{clubId} {
      allow read: if isClubAdmin(clubId);

      // The club's API key. Club admins can see it; only super admins (via
      // the rule at the top) can change it.
      match /private/{docId} {
        allow read: if isClubAdmin(clubId);
      }

      match /admins/{uid} {
        allow read: if isClubAdmin(clubId);
      }

      match /sheets/{sheetId} {
        // Club admins can read any sheet in their club.
        allow read: if isClubAdmin(clubId);

        // Club admins can manage sheets in their club (add pairing codes, add sheets).
        allow write: if isClubAdmin(clubId);

        // Only the registered scoreboard (matched by UID) can read the sheet.
        allow read: if request.auth != null
            && request.auth.uid == resource.data.scoreboardUid;

        // The registered scoreboard can update liveGame or clear its UID on
        // disconnect. It cannot hand the sheet to a different device.
        allow update: if request.auth != null
            && request.auth.uid == resource.data.scoreboardUid
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['liveGame', 'scoreboardUid'])
            && (!('scoreboardUid' in request.resource.data)
                || request.resource.data.scoreboardUid == request.auth.uid);

        match /games/{gameId} {
          // Club admins can read game history.
          allow read: if isClubAdmin(clubId);

          // Only the registered scoreboard can write game records.
          allow create: if request.auth != null
              && request.auth.uid ==
                  get(/databases/$(database)/documents/clubs/$(clubId)/sheets/$(sheetId)).data.scoreboardUid;
        }
      }
    }
  }
}
