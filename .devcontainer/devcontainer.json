{
  "name": "Curling Scoreboard",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Node for admin/, functions/ and the scripts; Java for the Firebase
  // emulators used by emulator-tests/.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"]
    }
  }
}
